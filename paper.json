{
  "epochs": 20,
  "batch_size": 512,
  "eval_batch_size": 512,
  "num_workers": 4,
  "hidden_dim": 128,
  "num_heads": 4,
  "dropout": 0.2,
  "lr": 0.0002,
  "weight_decay": 0.0001,
  "warmup_epochs": 2,
  "min_lr_ratio": 0.01,
  "grad_clip": 1.0,
  "mask_prob": 0.05,
  "rc_prob": 0.5,
  "label_smoothing": 0.1,
  "supcon_temperature": 0.1,
  "cls_weight": 1.0,
  "contra_weight": 0.1,
  "threshold": 0.5,
  "use_amp": true,
  "strict_determinism": true,
  "strict_expected_counts": true,
  "block_shuffle_size": 64,
  "max_open_shards": 64
}
